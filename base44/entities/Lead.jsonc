{
  "name": "Lead",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the DBC owner who collected this lead"
    },
    "qr_code_id": {
      "type": "string",
      "description": "ID of the QR code / DBC that generated this lead"
    },
    "qr_code_name": {
      "type": "string",
      "description": "Name of the source card at capture time"
    },
    "lead_name": {
      "type": "string",
      "description": "Name provided by the lead"
    },
    "lead_email": {
      "type": "string",
      "description": "Email provided by the lead"
    },
    "lead_phone": {
      "type": "string",
      "description": "Phone number provided by the lead"
    },
    "lead_tag": {
      "type": "string",
      "description": "Optional tag (e.g. Employee ID or Region Code) for routing leads after CSV export"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes provided by the lead (e.g. context about how they met or what they're interested in)"
    },
    "crm_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether this lead has been synced to HubSpot"
    },
    "crm_sync_error": {
      "type": "string",
      "description": "Last HubSpot sync error message, if any"
    },
    "sf_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether this lead has been synced to Salesforce"
    },
    "sf_sync_error": {
      "type": "string",
      "description": "Last Salesforce sync error message, if any"
    }
  },
  "required": [
    "user_email",
    "lead_name",
    "lead_email"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}