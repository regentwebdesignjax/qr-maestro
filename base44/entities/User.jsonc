{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "pro"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trialing",
        "past_due",
        "canceled"
      ],
      "default": "inactive"
    },
    "subscription_period": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "annual"
      ],
      "default": "none",
      "description": "Billing period for the active subscription"
    },
    "trial_end_date": {
      "type": "string",
      "description": "ISO date string when the trial ends"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for billing"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "custom_domain": {
      "type": "string",
      "description": "Custom domain configured by the user"
    },
    "custom_domain_addon": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has an active Custom Domain add-on subscription"
    },
    "custom_domain_addon_period": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "annual"
      ],
      "default": "none",
      "description": "Billing period for the Custom Domain add-on"
    },
    "purchased_extra_dbcs": {
      "type": "integer",
      "default": 0,
      "description": "Number of extra Digital Business Cards purchased beyond the base 10"
    }
  },
  "required": [
    "stripe_customer_id"
  ]
}