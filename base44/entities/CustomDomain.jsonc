{
  "name": "CustomDomain",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this custom domain"
    },
    "hostname": {
      "type": "string",
      "description": "The custom hostname (e.g. links.example.com)"
    },
    "cf_custom_hostname_id": {
      "type": "string",
      "description": "Cloudflare Custom Hostname ID for this domain"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "deactivated",
        "error"
      ],
      "default": "pending",
      "description": "Current status of the custom domain"
    },
    "ssl_status": {
      "type": "string",
      "description": "SSL certificate status from Cloudflare"
    },
    "ownership_status": {
      "type": "string",
      "description": "Ownership verification status from Cloudflare"
    }
  },
  "required": [
    "user_email",
    "hostname"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}