{
  "name": "CustomDomain",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the Pro user who owns this domain"
    },
    "hostname": {
      "type": "string",
      "description": "The full subdomain the user configured (e.g. qr.mybrand.com)"
    },
    "cf_custom_hostname_id": {
      "type": "string",
      "description": "Cloudflare custom hostname object ID returned by the Custom Hostnames API"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "deactivated", "error"],
      "default": "pending",
      "description": "pending = awaiting DNS/cert validation; active = verified and live; deactivated = add-on cancelled; error = Cloudflare reported a problem"
    },
    "ssl_status": {
      "type": "string",
      "description": "Raw SSL certificate status string from Cloudflare (e.g. pending_validation, active)"
    },
    "ownership_status": {
      "type": "string",
      "description": "Raw hostname ownership status from Cloudflare (e.g. pending, active)"
    }
  },
  "required": ["user_email", "hostname"]
}
